# Copy to .env and fill. NEVER commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
BRAND_NAME=Bolingo
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=Bolingo <no-reply@example.com>

# SMTP (production only; dev prints emails to the console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Postgres (leave empty to use SQLite)
DATABASE_URL=postgres://nousdeux:nousdeux@localhost:5432/nousdeux
REDIS_URL=redis://localhost:6379/0

# S3-compatible storage (MinIO in local)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nousdeux
S3_REGION=us-east-1
# Optional: endpoint reachable from phones for presigned uploads (dev: http://<LAN-IP>:9000)
S3_PUBLIC_ENDPOINT_URL=

# Field encryption (comma separated Fernet keys, newest first). Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=

# Optional AI reformulation (disabled by default)
AI_REFORMULATION_ENABLED=false
ANTHROPIC_API_KEY=

# Coach through OpenRouter (takes precedence over the Claude API when set)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Demo account password (make demo)
DEMO_PASSWORD=

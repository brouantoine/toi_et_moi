# Copy to .env.local (ignored). Public values only: everything EXPO_PUBLIC_* ships in the app.
EXPO_PUBLIC_API_URL=http://localhost:8000
# Google Sign-In (optional; button hidden when empty). Web client id = audience checked by the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client id (xxx.apps.googleusercontent.com); enables the Google config plugin URL scheme.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

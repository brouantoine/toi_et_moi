# Version de production (branche ios-release). Valeurs publiques uniquement : tout ce qui
# commence par EXPO_PUBLIC_ est intégré à l'application.
EXPO_PUBLIC_API_URL=https://api.bolingo.ci
# Liens d'invitation https://api.bolingo.ci/join/CODE qui ouvrent l'app (Associated Domains).
LINK_HOST=api.bolingo.ci
# Clé publique iOS RevenueCat (commence par appl_). Sans elle, l'achat de Plus est indisponible.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
# Connexion Google (facultative : le bouton est masqué si vide).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

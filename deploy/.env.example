# Copie en deploy/.env sur le serveur, puis remplis. Ne jamais commiter deploy/.env.

# --- Domaine et serveur ---
API_DOMAIN=api.bolingo.ci
PUBLIC_IP=1.2.3.4
PUBLIC_BASE_URL=https://api.bolingo.ci
DJANGO_ALLOWED_HOSTS=api.bolingo.ci,bolingo.ci,www.bolingo.ci
CSRF_TRUSTED_ORIGINS=https://api.bolingo.ci

# --- Secrets (génère-les : python3 -c "import secrets; print(secrets.token_urlsafe(50))") ---
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
# Clés Fernet pour chiffrer messages et coach :
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEYS=
TURN_SECRET=

# --- Appels ---
TURN_URLS=turn:api.bolingo.ci:3478?transport=udp,turn:api.bolingo.ci:3478?transport=tcp
CALLS_MEDIA_READY=true

# --- Stockage des photos et vocaux : OVH Object Storage (compatible S3) ---
S3_ENDPOINT_URL=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=bolingo-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Emails (SMTP, ex. OVH Email Pro ou Brevo) ---
DEFAULT_FROM_EMAIL=Bolingo <no-reply@bolingo.ci>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Pages légales et assistance ---
LEGAL_ENTITY=
LEGAL_ADDRESS=
SUPPORT_EMAIL=support@bolingo.ci

# --- Coach IA ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# --- Abonnements (RevenueCat) ---
REVENUECAT_WEBHOOK_AUTH=
BILLING_ACCEPT_SANDBOX=false

# --- Liens d'invitation qui ouvrent l'app (liens universels iOS / Android) ---
# IOS_APP_IDS = "<Team ID Apple>.com.bolingo.app" (Team ID : developer.apple.com > Membership)
IOS_APP_IDS=
ANDROID_PACKAGE=com.bolingo.app
# Empreinte SHA-256 du certificat de signature Play (Play Console > Intégrité de l'app)
ANDROID_CERT_FINGERPRINTS=
ANDROID_STORE_URL=
